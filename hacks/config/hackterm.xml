<?xml version="1.0" encoding="ISO-8859-1"?>

<screensaver name="hackterm" _label="Hackterm">

 <command arg="--root"/>

 <hgroup>
  <vgroup>

   <number id="panels" type="spinbutton" arg="--panels %"
           _label="Number of terminals" low="1" high="6" default="4"/>

   <number id="fontsize" type="spinbutton" arg="--font-size %"
           _label="Font size" low="6" high="24" default="12"/>

   <number id="speed" type="slider" arg="--speed %"
           _label="Typing speed" _low-label="Slow" _high-label="Fast"
           low="0.2" high="4.0" default="1.0"/>

   <select id="theme">
    <option id="phosphor"  _label="Vert phosphore (mono)" arg-set="--theme phosphor"/>
    <option id="green"     _label="Vert + accents"  arg-set="--theme green"/>
    <option id="amber"     _label="Ambre"           arg-set="--theme amber"/>
    <option id="blue"      _label="Bleu froid"      arg-set="--theme blue"/>
    <option id="dracula"   _label="Dracula"         arg-set="--theme dracula"/>
    <option id="solarized" _label="Solarized"       arg-set="--theme solarized"/>
    <option id="mono"      _label="Monochrome"      arg-set="--theme mono"/>
    <option id="red"       _label="Alerte rouge"    arg-set="--theme red"/>
   </select>

   <select id="font">
    <option id="monospace" _label="Monospace (défaut)"
            arg-set="--font Monospace"/>
    <option id="dejavu"    _label="DejaVu Sans Mono"
            arg-set="--font 'DejaVu Sans Mono'"/>
    <option id="liberation" _label="Liberation Mono"
            arg-set="--font 'Liberation Mono'"/>
    <option id="courier"   _label="Courier 10 Pitch"
            arg-set="--font 'Courier 10 Pitch'"/>
    <option id="noto"      _label="Noto Mono"
            arg-set="--font 'Noto Mono'"/>
    <option id="ubuntu"    _label="Ubuntu Mono"
            arg-set="--font 'Ubuntu Mono'"/>
    <option id="c64"       _label="Classic Console (C64)"
            arg-set="--font 'Classic Console'"/>
    <option id="ocr"       _label="OCR A"
            arg-set="--font 'OCR A'"/>
    <option id="apple2"    _label="gallant12x22 (Apple II)"
            arg-set="--font 'gallant12x22'"/>
   </select>

   <boolean id="titles" _label="Window title bars"
            arg-set="--titles" arg-unset="--no-titles"/>

  </vgroup>
 </hgroup>

 <xscreensaver-updater/>

 <_description xml:space="preserve">
A wall of consoles where a fictional intruder scans, brute-forces,
escalates and exfiltrates.  Every IP address, password and hash is
generated at random: none of it refers to anything real.

Written for XScreenSaver; MIT licence.
 </_description>

</screensaver>
